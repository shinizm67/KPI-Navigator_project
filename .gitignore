# OS
.DS_Store
Thumbs.db

# 環境・秘密情報（例）
.env
.env.local
*.pem

# Backend Phase A/B — local secrets & stored blobs
api/v1/config.local.php
api/v1/data/*.json
api/v1/data/**/*.json
!api/v1/data/.gitkeep
!api/v1/data/users/.gitkeep
api/v1/data/*.tmp
# Keep backups/ tree in repo; ignore only JSON snapshots inside
api/v1/data/backups/**
!api/v1/data/backups/
!api/v1/data/backups/.gitkeep

# 依存関係（プロジェクトの種類に応じて）
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.venv-js/

# Office 一時ロックファイル
~$*
.~lock.*

# 検証・開発用の一時スクリーンショット
tmp-*.png
tmp-focus-screens/
assets/shot_*.png

# 動画（GitHubは100MB超を拒否するため）
*.mov

# SpecStory 履歴にトークン等が混入しうるため push 対象外（ローカルのみ）
.specstory/history/

app/monthly/edit/config.local.php
